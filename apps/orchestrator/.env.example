# Agentmetry orchestrator — copy to .env and adjust
# cp apps/orchestrator/.env.example apps/orchestrator/.env
# Never commit .env — it is gitignored

# Demo MCP vault path (relative to this directory)
AGENTMETRY_VAULT_PATH=../../vault

# Who ran the agent. Leave empty and every event records the OS account the
# agent ran as (DOMAIN\user on a domain or Entra Windows account). Set it to
# override: an email, or a pseudonym to keep account names out of a SIEM.
AGENTMETRY_OPERATOR_ID=
AGENTMETRY_FLEET_ID=

# Per-fleet secret for tool-argument fingerprints. Unset: plain SHA-256, which
# anyone with the trail or SIEM can recompute for a guessable argument. Set:
# HMAC-SHA256 under this key, labelled input_redaction "hmac". Use the same
# value on every host in a fleet so fingerprints still correlate.
AGENTMETRY_HASH_KEY=

# Host names the API answers to besides localhost / 127.0.0.1 / ::1. Anything
# else gets 400 (DNS-rebinding guard). Set this when the API is reached by
# another name: a container service name, a LAN address, a reverse proxy.
# AGENTMETRY_TRUSTED_HOSTS=orchestrator,devbox.corp.example

# The API needs a token by default: the first start writes one, owner-only,
# to the data directory, and the hooks and CLI read it from there. Set this
# only to distribute your own key across a fleet; it then replaces the file.
# AGENTMETRY_AUTH_DISABLED=1 turns authentication off (development only).
AGENTMETRY_API_KEY=

# Hook boundary — log | block | disable
AGENTMETRY_TOOL_POLICY_MODE=log
AGENTMETRY_DLP_MODE=log

# Audit export (JSONL + SQLite index)
AGENTMETRY_AUDIT_EXPORT_ENABLED=1
AGENTMETRY_AUDIT_SINK=file
# Network sinks forward from the trail with a cursor, batching and retrying
# while the SIEM is down. 0 = the old inline one-request-per-event sinks.
# AGENTMETRY_AUDIT_FORWARDER=1
# Rotate the trail into <trail>.archive/ at this size; the chain continues
# across segments and nothing is deleted (docs/trail-retention.md). 0 = never.
# AGENTMETRY_TRAIL_ROTATE_BYTES=268435456

# Anchor log, when it is not the file sitting beside the trail. Point this at a
# working copy of a remote this machine cannot rewrite and `verify --trail` and
# `doctor` will check against it without being handed --anchors. Unset is fine:
# the chain still verifies, it just cannot survive an attacker who owns this
# host. See docs/anchoring.md.
# AGENTMETRY_ANCHOR_LOG=../agentmetry-anchors/home-lab/agentmetry-trail.anchors.jsonl

# The configured MCP servers as an `mcp_inventory` event, for a fleet that wants
# them in the SIEM: names, launchers, package names and hosts, never arguments or
# env values. Off by default, because the heartbeat names no server.
# AGENTMETRY_MCP_INVENTORY=1

# More tuning: see repo root .env.example and docs/agentmetry-dogfood-checklist.md
