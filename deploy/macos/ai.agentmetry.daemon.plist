<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.agentmetry.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/lib/agentmetry/agentmetry-daemon.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>UserName</key>
	<string>root</string>
	<key>StandardOutPath</key>
	<string>/var/db/agentmetry/logs/daemon.out.log</string>
	<key>StandardErrorPath</key>
	<string>/var/db/agentmetry/logs/daemon.err.log</string>
</dict>
</plist>
